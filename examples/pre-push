#!/bin/sh
# git pre-push hook: judge every commit this push would publish, before it leaves the machine.
#
#   cp examples/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# git runs the hook as `pre-push <remote name> <url>` and hands it one line per ref:
# <local ref> <local sha> <remote ref> <remote sha>. For an existing branch the new commits
# are remote..local. For a new branch they are the commits THIS DESTINATION's remote-tracking
# refs do not hold yet; when the destination is a bare URL with no tracking refs, every
# commit reachable from the pushed tip is judged. A commit another remote already holds (a
# private mirror, a fork) proves nothing about this destination, so it is never excluded.
# Findings (exit 1) and NOT EVALUABLE (exit 2) both stop the push. Your denylist is read as
# usual ($PUBLISH_GATE_DENYLIST or ~/.config/publish-gate/denylist). To push anyway, after
# reading the findings: `git push --no-verify`.
remote_name=$1
known_remote=
if [ -n "$remote_name" ] && git remote | grep -qxF -- "$remote_name"; then
    known_remote=$remote_name
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case $local_sha in *[!0]*) ;; *) continue ;; esac      # deleting a ref publishes nothing
    case $remote_sha in
        *[!0]*) range="$remote_sha..$local_sha" ;;
        *)                                                  # a new branch on this destination
            if [ -n "$known_remote" ]; then
                range="$local_sha --not --remotes=$known_remote"
            else
                range="$local_sha"
            fi ;;
    esac
    echo "publish-gate: $local_ref -> $remote_ref" >&2
    publish-gate . --history --range "$range" >&2
    rc=$?
    [ "$rc" -gt "$status" ] && status=$rc
done
exit "$status"
